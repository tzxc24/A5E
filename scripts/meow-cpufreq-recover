#!/bin/sh
set -eu

state=/var/lib/meow-os/cpufreq-sleep.state
initialized=/var/lib/meow-os/cpufreq-policy-initialized
boost_state=/var/lib/meow-os/cpufreq-boost.state
boost_initialized=/var/lib/meow-os/cpufreq-boost-initialized
restored=0

# The independent supervisor owns all maximum-frequency limits now. Never
# replay legacy sleep ceilings behind an active thermal protection latch.
if [ -r /opt/meow-os/bin/meow-power.py ]; then
    if [ -s "$boost_state" ]; then
        while IFS="$(printf '\t')" read -r path value; do
            case "$path" in
                /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq) ;;
                *) continue ;;
            esac
            case "$value" in ''|*[!0-9]*) continue ;; esac
            current=$(cat "$path" 2>/dev/null || true)
            case "$current" in ''|*[!0-9]*) continue ;; esac
            if [ -w "$path" ] && [ "$value" -lt "$current" ]; then
                printf '%s\n' "$value" > "$path"
            fi
        done < "$boost_state"
    fi
    echo 'MeowOS: CPU ceilings are managed by meow-power.service'
    exit 0
fi

if [ -s "$state" ]; then
    while IFS="$(printf '\t')" read -r path value; do
        case "$path" in
            /sys/devices/system/cpu/cpufreq/policy*/scaling_max_freq) ;;
            *) continue ;;
        esac
        case "$value" in
            ''|*[!0-9]*) continue ;;
        esac
        [ -w "$path" ] || continue
        printf '%s\n' "$value" > "$path"
        restored=1
    done < "$state"
    rm -f "$state"
fi

if [ -s "$boost_state" ]; then
    while IFS="$(printf '\t')" read -r path value; do
        case "$path" in
            /sys/devices/system/cpu/cpufreq/policy*/scaling_min_freq) ;;
            *) continue ;;
        esac
        case "$value" in
            ''|*[!0-9]*) continue ;;
        esac
        [ -w "$path" ] || continue
        printf '%s\n' "$value" > "$path"
        restored=1
    done < "$boost_state"
    rm -f "$boost_state"
fi

# One-time migration for installations affected by the old in-memory-only
# sleep limiter. Afterwards only an explicit sleep-state file authorizes a
# ceiling restore, so later user policy choices remain untouched.
if [ ! -e "$initialized" ]; then
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] || continue
        current=$(cat "$policy/scaling_max_freq" 2>/dev/null || true)
        hardware=$(cat "$policy/cpuinfo_max_freq" 2>/dev/null || true)
        if [ "$current" = 408000 ] && [ -n "$hardware" ] && [ "$hardware" -gt 408000 ]; then
            printf '%s\n' "$hardware" > "$policy/scaling_max_freq"
            restored=1
        fi
    done
    : > "$initialized"
fi

# One-time migration for a process killed while the pre-persistence boost was
# active. Only the exact hardware-maximum signature is normalized.
if [ ! -e "$boost_initialized" ]; then
    for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] || continue
        current=$(cat "$policy/scaling_min_freq" 2>/dev/null || true)
        hardware_min=$(cat "$policy/cpuinfo_min_freq" 2>/dev/null || true)
        hardware_max=$(cat "$policy/cpuinfo_max_freq" 2>/dev/null || true)
        if [ -n "$hardware_min" ] && [ "$current" = "$hardware_max" ] && [ "$hardware_min" -lt "$current" ]; then
            printf '%s\n' "$hardware_min" > "$policy/scaling_min_freq"
            restored=1
        fi
    done
    : > "$boost_initialized"
fi

if [ "$restored" -eq 1 ]; then
    echo "MeowOS: restored CPU frequency policy ceilings"
fi
